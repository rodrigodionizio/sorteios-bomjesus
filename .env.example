# ============================================================================
# Modelo das variáveis de ambiente — Sorteios Bom Jesus
#
# Copie para `.env.local` e preencha. O `.env.local` é ignorado pelo Git;
# este arquivo é versionado justamente para não ser preciso adivinhar
# quais variáveis existem numa máquina nova.
#
# A Vercel não lê nenhum destes arquivos: lá as variáveis são cadastradas
# no painel do projeto (ver 12-guia-de-operacao-e-deploy.md).
#
# Onde achar os valores: painel do Supabase → seu projeto →
# Settings → API (em alguns projetos aparece como "API Keys").
# ============================================================================

# "Project URL" — algo como https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# A chave ANÔNIMA (aparece como "anon public" ou "publishable").
#
# ⚠️ NUNCA use aqui a `service_role`. Tudo que começa com NEXT_PUBLIC_ é
#    embutido no JavaScript entregue ao navegador — a service_role ignora
#    RLS por completo e vazaria acesso total ao banco. Este projeto não usa
#    service_role em lugar nenhum, de propósito (ver o arquivo 06 da
#    documentação técnica).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional. Base para metadados, sitemap e imagem de compartilhamento.
# Sem isso, o código cai no domínio de produção (src/lib/site.ts), o que
# faria os links locais apontarem para lá.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
